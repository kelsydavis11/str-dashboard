# Template for Streamlit Community Cloud secrets.
# On the cloud: App → ⋮ → Settings → Secrets → paste the filled-in version.
# Locally: copy to .streamlit/secrets.toml (git-ignored) with real values.
# Never commit real values.

GOOGLE_SHEET_ID = "your-google-sheet-id"

# --- Option A: reuse your personal OAuth token (fastest — from token.json) ---
# May stop working every ~7 days if the OAuth app is in "Testing" mode; if so,
# re-run `node reauth-google.mjs` locally and paste the new refresh_token, or
# publish the OAuth consent screen, or switch to Option B.
[google_token]
type = "authorized_user"
client_id = "xxxxx.apps.googleusercontent.com"
client_secret = "xxxxx"
refresh_token = "xxxxx"

# --- Option B: service account (durable — never expires; recommended) ---
# Create in Google Cloud Console, enable the Google Sheets API, download the JSON
# key, and share the Sheet with the service account's client_email (Viewer).
# Use EITHER Option A or Option B, not both.
# [gcp_service_account]
# type = "service_account"
# project_id = "your-project"
# private_key_id = "xxxxx"
# private_key = "-----BEGIN PRIVATE KEY-----\nMII...\n-----END PRIVATE KEY-----\n"
# client_email = "str-dashboard@your-project.iam.gserviceaccount.com"
# client_id = "xxxxx"
# token_uri = "https://oauth2.googleapis.com/token"
